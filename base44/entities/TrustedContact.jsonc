{
  "name": "TrustedContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "avatar_color": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "active"
      ],
      "default": "pending"
    },
    "online": {
      "type": "boolean",
      "default": false
    },
    "location_sharing": {
      "type": "boolean",
      "default": true
    },
    "is_emergency_contact": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "relationship"
  ]
}