{
  "name": "EmergencyEvent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "sos",
        "fall_detected",
        "voice_distress",
        "manual",
        "route_deviation"
      ],
      "default": "sos"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "cancelled",
        "false_alarm"
      ],
      "default": "active"
    },
    "location_label": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Time-stamped GPS points logged periodically while the emergency is active, compiled into the shareable incident report for authorities."
    },
    "battery_level": {
      "type": "number"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "contacts_notified": {
      "type": "boolean",
      "default": false
    },
    "evidence_recording": {
      "type": "boolean",
      "default": false
    },
    "evidence_upload_progress": {
      "type": "number",
      "default": 0
    },
    "evidence_clips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Private (encrypted) storage URIs of recorded SOS audio clips, saved for later review."
    },
    "evidence_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Private (encrypted) storage URIs of photos captured from the front and back cameras on SOS."
    },
    "evidence_videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Private (encrypted) storage URIs of back-camera video chunks recorded during the SOS emergency."
    }
  },
  "required": [
    "type",
    "status"
  ]
}